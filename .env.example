# =====================================================================
# Aili's Craft — environment variable template.
# Copy to .env (or set these in your host's dashboard / Vercel env vars).
# No real secrets are stored in the codebase; every value below is a
# placeholder. Leave optional vars empty to use the built-in default.
# =====================================================================

# --- Database (defaults match a fresh XAMPP/Laragon install) ---
AC_DB_HOST=127.0.0.1          # MySQL/MariaDB host
AC_DB_PORT=3306                # MySQL port
AC_DB_NAME=ailiscraft_db       # database name (import ailiscraft_database_schema.sql)
AC_DB_USER=root                # DB user
AC_DB_PASS=                    # DB password (set in production!)

# --- App runtime ---
AC_APP_URL=https://your-shop.example.com   # public base URL, NO trailing slash; auto-detected if empty
AC_DEBUG=0                                 # 1 = show raw DB errors (dev only), 0 = production
AC_SESSION_DRIVER=files                    # files (default) | db (needs migration 007 + ac_sessions table)

# --- Email (password resets). Leave AC_EMAIL_API_KEY empty = log-only mode ---
AC_EMAIL_PROVIDER=brevo        # brevo | resend | phpmail | logonly
AC_EMAIL_API_KEY=              # Brevo v3 or Resend API key (empty = log to logs/reset_links.log)
AC_EMAIL_FROM_NAME="Aili's Craft"
AC_EMAIL_FROM_ADDR=no-reply@ailiscraft.ph   # must be a verified sender at your provider

# --- SMS (order-status notifications). Default textbelt key is a public free tier ---
AC_SMS_PROVIDER=textbelt       # textbelt | twilio | semaphore | logonly
AC_SMS_API_KEY=textbelt        # 'textbelt' = free tier (1/day/IP); paste paid key for volume
AC_SMS_SENDER=AilisCraft       # 3-11 char sender ID (Semaphore only)
AC_TWILIO_SID=                 # Twilio Account SID (only if AC_SMS_PROVIDER=twilio)
AC_TWILIO_TOKEN=               # Twilio Auth Token
AC_TWILIO_FROM=                # Twilio from number, e.g. +1234567890

# --- Facebook Messenger (order updates via Send-to-Messenger button) ---
AC_FB_PAGE_ACCESS_TOKEN=       # long-lived Page Access Token; empty = Messenger disabled
AC_FB_VERIFY_TOKEN=            # random string, must match the Meta App webhook verify token
AC_FB_APP_ID=                  # Meta App ID (renders the Send-to-Messenger button)
AC_FB_PAGE_ID=                 # Facebook Page ID (numeric)

# --- Cloudinary image storage (optional). If all three set, special-request
#     photos upload to Cloudinary; otherwise they save locally under uploads/ ---
AC_CLOUDINARY_CLOUD_NAME=      # your Cloudinary cloud name
AC_CLOUDINARY_API_KEY=         # Cloudinary API key
AC_CLOUDINARY_API_SECRET=      # Cloudinary API secret
AC_CLOUDINARY_FOLDER=          # optional folder/prefix inside Cloudinary (e.g. ailiscraft/sr)

# --- Deployment gates (optional) ---
AC_ENABLE_SOURCE_BROWSER=0     # 0 = AilisCraftAdmin/source-code.php returns 403 (recommended); 1 = enable on trusted host
AC_ADMIN_SETUP_TOKEN=          # if set, setup_accounts.php requires ?token=<this> and may run off-localhost; DELETE setup_accounts.php after seeding
