# Upload directory: disable script execution and directory listing.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
<FilesMatch "\.(php|phtml|php3|php4|php5|phar|pl|py|cgi|sh|pht)$">
    Require all denied
</FilesMatch>
# Never serve sensitive file types from the upload directory (logs may contain
# reset tokens / phone numbers; .env / .ini / .sql / .md / .bak are config or
# backup leaks). Active log files live in AilisCraftUser/logs/ (web-denied).
<FilesMatch "\.(log|ini|sql|md|env|bak)$">
    Require all denied
</FilesMatch>
Options -ExecCGI -Indexes
