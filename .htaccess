# =====================================================================
# Aili's Craft — root security hardening (Apache / LiteSpeed).
# The three panels (AilisCraftUser / AilisCraftOwner / AilisCraftAdmin)
# are SIBLING directories — do NOT flatten. Cross-panel API calls use
# ../AilisCraftUser/api/... relative paths.
# =====================================================================
Options -Indexes
ServerSignature Off

# --- Security response headers ---
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
</IfModule>

# --- Never serve sensitive file types anywhere under the web root ---
<FilesMatch "\.(log|ini|sql|md|env|bak|sh|phar|zip|tar|gz)$">
    Require all denied
</FilesMatch>

# --- Deny all dotfiles (.env, .user.ini, .htaccess, .git, ...) ---
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# --- HTTPS redirect — enable ONLY after TLS is confirmed working,
#     otherwise you can lock yourself out of the site.
# <IfModule mod_rewrite.c>
#     RewriteEngine On
#     RewriteCond %{HTTPS} off
#     RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>
