# Upload directory: disable script execution and directory listing.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
<FilesMatch "\.(php|phtml|php3|php4|php5|phar|pl|py|cgi|sh|pht)$">
    Require all denied
</FilesMatch>
Options -ExecCGI -Indexes
